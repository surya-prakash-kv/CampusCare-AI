
# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_database_password
DB_SSLMODE=disable

# JWT Authentication
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login Rate Limiting
RATE_LIMIT_HASH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
LOGIN_RATE_LIMIT_EMAIL_IP_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# AI Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Recovery
AI_RECOVERY_INTERVAL_SECONDS=30
AI_RECOVERY_STALE_AFTER_SECONDS=120
AI_RECOVERY_BATCH_SIZE=10

# Vercel Cron Authentication
CRON_SECRET=replace_with_a_random_secret_of_at_least_32_characters
