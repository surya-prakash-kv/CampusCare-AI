# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=replace_with_a_secure_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Login Rate Limiting
RATE_LIMIT_HASH_SECRET=replace_with_a_separate_secure_secret_of_at_least_32_characters
LOGIN_RATE_LIMIT_EMAIL_IP_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
